{
  "name": "tsgodown-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter tsgodown run dev",
    "tsgodown": "node --import tsx packages/cli/src/index.ts",
    "manifest:sample": "tsx scripts/generate-manifest.ts",
    "test": "pnpm -r --filter './packages/*' --if-present run test",
    "test:tdd": "pnpm run build && pnpm run test",
    "typecheck": "pnpm run build",
    "lint": "biome lint .",
    "format:check": "biome check . --linter-enabled=false",
    "format": "biome format --write .",
    "gate:m1": "./scripts/m1-release-gate.sh",
    "gate:semantics-parity": "node --import tsx --test packages/cli/test/commands.e2e.test.ts --test-name-pattern \"CLI JSON contract fixtures: success path|CLI JSON contract fixtures: warn path|rust-only fixture matrix surfaces deterministic contract error path\" && cargo test -p rust-bundler-manifest-v1 --test contract && pnpm run harness:differential && pnpm run gate:coverage-ratchet",
    "gate:coverage-ratchet": "node scripts/check-differential-coverage-ratchet.mjs",
    "gate:differential": "pnpm run gate:semantics-parity",
    "gate:node-corpus-parity": "node scripts/node-corpus-parity.mjs",
    "gate:node-corpus-parity:node": "node scripts/node-corpus-parity.mjs --node-only",
    "gate:node-corpus-parity:generate": "node scripts/generate-node-corpus-go.mjs",
    "gate:node-corpus-compiler-audit": "node scripts/audit-node-corpus-compiler-completion.mjs",
    "node-corpus:vectors:generate": "node scripts/generate-node-corpus-vectors.mjs",
    "test:node-corpus:vitest": "vitest run test-corpus/node-real/tests/node-corpus.test.mjs",
    "gate:node-corpus-general-compiler": "node scripts/audit-node-corpus-general-compiler.mjs",
    "test:ir-go-codegen": "node --test scripts/executable-ir-go-codegen.test.mjs",
    "gate:compliance": "node --import tsx --test packages/cli/test/commands.e2e.test.ts --test-name-pattern \"CLI rejects removed legacy compiler command\" && pnpm run guard:compiler-mode-only && pnpm run guard:core-path && pnpm run guard:framework-defaults",
    "perf:baseline": "tsx scripts/perf-baseline.ts",
    "docs:scaffold:sync": "node scripts/check-fastify-scaffold-sync.mjs",
    "scaffold:sync:check": "node scripts/check-scaffold-sync.mjs",
    "scaffold:sync:write": "node scripts/check-scaffold-sync.mjs --write",
    "examples:install-first:check": "node scripts/check-example-install-first.mjs",
    "guard:compiler-mode-only": "node scripts/guard-compiler-mode-only.mjs",
    "guard:core-path": "node scripts/guard-core-path-no-framework-branching.mjs",
    "guard:framework-defaults": "node scripts/guard-framework-defaults.mjs",
    "test:guard:core-path": "node --test scripts/guard-core-path-no-framework-branching.test.mjs",
    "test:guard:framework-defaults": "node --test scripts/guard-framework-defaults.test.mjs",
    "harness:semantics-parity": "node scripts/differential-harness.mjs --all",
    "harness:differential": "pnpm run harness:semantics-parity"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@biomejs/biome": "^1.9.4",
    "vitest": "^3.2.4"
  }
}
