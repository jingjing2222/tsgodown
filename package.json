{
  "name": "tsgodown-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter tsgodown run dev",
    "tsgodown": "node --import tsx packages/cli/src/index.ts",
    "manifest:sample": "tsx scripts/generate-manifest.ts",
    "test": "pnpm run guard:runtime && pnpm -r --filter './packages/*' --if-present run test",
    "guard:runtime": "node scripts/guard-no-legacy-ts-analyzer.mjs",
    "test:tdd": "pnpm run build && pnpm run test",
    "typecheck": "pnpm run build",
    "lint": "biome lint .",
    "format:check": "biome check . --linter-enabled=false",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@biomejs/biome": "^1.9.4"
  }
}
